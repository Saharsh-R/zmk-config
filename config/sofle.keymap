#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        ht_tp: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        tmux: tmux {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_tap>,
                <&kp LC(A) &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp GRAVE     &kp N1          &kp N2             &kp N3               &kp N4               &kp N5                                                 &kp N6          &kp N7               &kp N8         &kp N9             &kp N0                          &kp MINUS
&kp TAB       &ht_tp LG(Q) Q  &ht_tp LG(W) W     &kp E                &kp R                &ht_tp LG(T) T                                         &kp Y           &kp U                &kp I          &kp O              &ht_tp LG(P) P                  &kp LEFT_BRACKET
&lt 3 ESCAPE  &ht_tp LCTRL A  &ht_tp LEFT_ALT S  &ht_tp LCMD D        &ht_tp LEFT_SHIFT F  &kp G                                                  &kp H           &ht_tp LEFT_SHIFT J  &ht_tp LCMD K  &ht_tp LEFT_ALT L  &ht_tp RIGHT_CONTROL SEMICOLON  &kp SQT
&kp LSHFT     &ht_tp LG(Z) Z  &ht_tp LG(X) X     &ht_tp LG(C) C       &ht_tp LG(V) V       &kp B           &kp C_MUTE               &bt BT_SEL 0  &ht_tp LG(N) N  &kp M                &kp COMMA      &kp DOT            &kp FSLH                        &kp RSHFT
                              &lt 2 LG(LS(V))    &mt LCTRL LC(SPACE)  &mt LALT LA(SPACE)   &lt 1 ENTER     &ht_tp LGUI BACKSPACE    &lt 4 SPACE   &lt 1 LEFT      &kp DOWN             &kp UP_ARROW   &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "lower";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans     &kp LS(LG(NUMBER_1))  &kp LS(LG(NUMBER_2))  &kp LS(LG(NUMBER_3))  &kp LG(LS(NUMBER_4))   &kp LS(LG(NUMBER_5))                    &kp F6         &kp F7          &kp F8          &kp F9     &kp F10        &kp F11
&kp GRAVE  &kp LEFT_BRACE        &kp RBRC              &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PIPE                                &kp BACKSLASH  &kp EQUAL       &kp UNDERSCORE  &kp PLUS   &kp LS(LG(P))  &kp PIPE
&trans     &kp EXCLAMATION       &kp AT                &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp BACKSLASH                           &kp CARET      &kp EQUAL       &kp UNDER       &kp PLUS   &kp RPAR       &kp MINUS
&trans     &kp NUMBER_1          &kp NUMBER_2          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp N5                &trans    &trans  &kp LEFT       &kp DOWN_ARROW  &kp UP_ARROW    &kp RIGHT  &trans         &trans
                                 &trans                &trans                &trans                 &trans                &trans    &trans  &trans         &trans          &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                               &none           &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                            &studio_unlock  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                                      &none           &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &rgb_ug RGB_TOG    &none  &none           &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none              &none  &none           &none  &none  &none
            >;
        };

        esc_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans            &trans    &trans        &trans             &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LG(LA(LEFT))  &trans    &trans        &kp LG(LA(RIGHT))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LEFT          &kp DOWN  &kp UP_ARROW  &kp RIGHT          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans        &trans             &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans        &trans
            >;
        };

        tmux {
            display-name = "tmux";

            // Every printable key sends Ctrl+A + that key (the tmux prefix).
            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
            // |       |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   [   |
            // |       |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // |       |  Z  |  X  |  C   |  V   |  B   |        |  |       |  N   |  M    |  ,    |  .   |   /   |       |
            //                                                              | LEFT | DOWN  |  UP   | RGHT |

            bindings = <
&tmux GRAVE  &tmux N1  &tmux N2  &tmux N3  &tmux N4  &tmux N5                              &tmux N6    &tmux N7    &tmux N8        &tmux N9     &tmux N0         &tmux MINUS
&trans       &tmux Q   &tmux W   &tmux E   &tmux R   &tmux T                               &tmux Y     &tmux U     &tmux I         &tmux O      &tmux P          &tmux LEFT_BRACKET
&trans       &tmux A   &tmux S   &tmux D   &tmux F   &tmux G                               &tmux H     &tmux J     &tmux K         &tmux L      &tmux SEMICOLON  &tmux SQT
&trans       &tmux Z   &tmux X   &tmux C   &tmux V   &tmux B   &trans              &trans  &tmux N     &tmux M     &tmux COMMA     &tmux DOT    &tmux FSLH       &trans
                       &trans    &trans    &trans    &trans    &trans              &trans  &tmux LEFT  &tmux DOWN  &tmux UP_ARROW  &tmux RIGHT
            >;
        };
    };
};
